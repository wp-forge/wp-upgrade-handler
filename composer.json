{
    "name": "wp-forge/wp-upgrade-handler",
    "description": "A drop-in library for handling upgrade routines in WordPress plugins and themes.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Micah Wood",
            "email": "micah@wpscholar.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "WP_Forge\\UpgradeHandler\\": "includes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WP_Forge\\UpgradeHandler\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover coverage.xml"
    },
    "config": {
        "sort-packages": true
    }
}
